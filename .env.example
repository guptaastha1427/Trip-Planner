# Copy to `.env` and fill in (never commit `.env`).

# Google Gemini API key — https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-key-here
# Optional — defaults to gemini-embedding-001 with fallbacks for policy RAG / FAISS
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001

OSM_CONTACT_EMAIL=you@example.com
# Optional — default tries overpass-api.de plus public mirrors on 502/503/504
# OVERPASS_URL=https://overpass.openstreetmap.fr/api/interpreter
# OVERPASS_TIMEOUT_SEC=35
# Set true for Wikivoyage RAG (slower). Fast mode keeps this off by default.
ENABLE_WIKIVOYAGE_RAG=false
# Extra Gemini call for "Know before you go" copy (slower). Default off.
DESTINATION_GUIDE_AI=false
# Policy RAG: cache retrieved Terms KB chunks only (not LLM answers). Default off.
SEMANTIC_CACHE_ENABLED=false
# SEMANTIC_CACHE_THRESHOLD=0.91
# SEMANTIC_CACHE_MAX_ENTRIES=200
# Cache policy-bot system prompt via Gemini CachedContent (not user question or chunks). Default off.
GEMINI_PROMPT_CACHE_ENABLED=false
